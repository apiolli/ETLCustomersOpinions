<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="OpinionesClientesDB"
         connectionString="Server=Cesar-Diaz;Database=OpinionesClientesDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Carpetas relativas al directorio de salida (bin\...\net10.0) -->
    <add key="CarpetaCsv" value="CsvFiles" />
    <add key="CarpetaCsvSucios" value="CsvFiles_Sucios" />
    <add key="CarpetaRechazados" value="Rechazados" />
    <!-- true: crea clientes/productos provisionales (EsInferido = 1) para las encuestas.
         false: esas encuestas se rechazan por integridad referencial. -->
    <add key="CrearProvisionales" value="true" />
  </appSettings>
</configuration>
