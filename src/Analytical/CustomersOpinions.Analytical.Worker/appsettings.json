{
  "ConnectionStrings": {
    "TransactionalDb": "",
    "AnalyticalDb": ""
  },
  "Worker": {
    "RunMode": "Once",
    "Stage": "All",
    "IntervalMinutes": 60
  },
  "DimensionLoad": {
    "CommandTimeoutSeconds": 120,
    "KeywordMinLength": 4,
    "KeywordMinOccurrences": 2,
    "Events": [
      { "Name": "Black Friday 2024", "Type": "Promoción", "StartDate": "2024-11-29", "EndDate": "2024-12-02" },
      { "Name": "Navidad 2024", "Type": "Temporada", "StartDate": "2024-12-15", "EndDate": "2024-12-31" },
      { "Name": "Día de las Madres 2025", "Type": "Campaña", "StartDate": "2025-05-18", "EndDate": "2025-05-25" },
      { "Name": "Rebajas de verano 2025", "Type": "Promoción", "StartDate": "2025-07-01", "EndDate": "2025-07-31" },
      { "Name": "Regreso a clases 2025", "Type": "Temporada", "StartDate": "2025-08-15", "EndDate": "2025-09-05" }
    ]
  },
  "Extraction": {
    "BatchSize": 5000,
    "MaxDegreeOfParallelism": 5
  },
  "Sources": {
    "Surveys": {
      "Enabled": true,
      "FilePath": "Data/surveys_part1.csv"
    },
    "WebReviews": { "Enabled": true, "CommandTimeoutSeconds": 120 },
    "Customers":  { "Enabled": true, "CommandTimeoutSeconds": 120 },
    "Products":   { "Enabled": true, "CommandTimeoutSeconds": 120 },
    "SocialComments": {
      "Enabled": true,
      "BaseUrl": "https://localhost:7181",
      "Endpoint": "/api/v1/social-comments",
      "PageSize": 500,
      "MaxPages": 10000,
      "TimeoutSeconds": 30,
      "RetryCount": 3,
      "ApiKey": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System": "Warning", "Polly": "Fatal" }
    }
  }
}
