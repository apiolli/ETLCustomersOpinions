{
  "ConnectionStrings": {
    "TransactionalDb": "",
    "AnalyticalDb": ""
  },
  "Worker": {
    "RunMode": "Once",
    "IntervalMinutes": 60
  },
  "Extraction": {
    "BatchSize": 5000,
    "MaxDegreeOfParallelism": 5
  },
  "Sources": {
    "Surveys": {
      "Enabled": true,
      "FilePath": "Data/surveys_part1.csv"
    },
    "WebReviews": { "Enabled": true, "CommandTimeoutSeconds": 120 },
    "Customers":  { "Enabled": true, "CommandTimeoutSeconds": 120 },
    "Products":   { "Enabled": true, "CommandTimeoutSeconds": 120 },
    "SocialComments": {
      "Enabled": true,
      "BaseUrl": "https://localhost:7181",
      "Endpoint": "/api/v1/social-comments",
      "PageSize": 500,
      "MaxPages": 10000,
      "TimeoutSeconds": 30,
      "RetryCount": 3,
      "ApiKey": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System": "Warning", "Polly": "Fatal" }
    }
  }
}
