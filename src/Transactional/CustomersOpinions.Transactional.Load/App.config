<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="OpinionesClientesDB"
         connectionString="Server=Cesar-Diaz;Database=OpinionesClientesDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="CsvFolder" value="CsvFiles" />
    <add key="DirtyCsvFolder" value="CsvFilesDirty" />
    <add key="RejectedFolder" value="Rejected" />
    <add key="CreateInferredRecords" value="true" />
  </appSettings>
</configuration>
